rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() { return request.auth != null; }
    
    // Check if user is signed in anonymously
    function isAnonymous() { 
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous'; 
    }
    
    // Safely check role based on known staff emails for the prototype
    function isAdmin() { return isAuthenticated() && request.auth.token.email == 'admin@restaurant.com'; }
    function isCashier() { return isAuthenticated() && request.auth.token.email == 'cashier@restaurant.com'; }
    function isKitchen() { return isAuthenticated() && request.auth.token.email == 'kitchen@restaurant.com'; }
    function isAdminOrCashier() { return isAdmin() || isCashier(); }

    // ─── MENU ───────────────────────────────────────────
    match /menu/{item} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || 
        ((isAnonymous() || isCashier()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'available']));
    }

    // ─── SETTINGS ───────────────────────────────────────
    match /settings/{setting} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── TABLES ─────────────────────────────────────────
    match /tables/{table} {
      allow read: if true;
      allow create, delete: if isAdminOrCashier();
      // Anonymous customers can safely update table occupancy ONLY
      allow update: if isAdminOrCashier() || isKitchen() ||
        (isAnonymous() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'currentOrderId', 'occupiedAt', 'updatedAt']) &&
         request.resource.data.status in ['available', 'occupied', 'reserved']);
    }

    // ─── ORDERS ─────────────────────────────────────────
    match /orders/{order} {
      allow read: if true;
      allow create: if isAnonymous() || isAdminOrCashier(); // Customers and staff can place orders
      
      allow update: if isAdminOrCashier() || isKitchen();
        
      allow delete: if isAdmin();
    }

    // ─── USERS ──────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}